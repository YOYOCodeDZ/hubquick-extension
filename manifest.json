{
  "manifest_version": 3,
  "name": "Hubquick - HubSpot Deals & Quotes Helper",
  "version": "1.0.0",
  "description": "Premium line items exporter and custom-sort companion for HubSpot Deals and Quotes.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://app.hubspot.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hubquick Control Panel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.hubspot.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ]
}
